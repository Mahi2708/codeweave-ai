{
  "name": "codeweave-ai",
  "displayName": "CodeWeave AI",
  "description": "AI-powered project tree, project structure manager, file and folder manager, and code transformation toolkit for VS Code.",
  "version": "0.1.0",
  "publisher": "mahantheshdev",
  "license": "MIT",

  "repository": {
    "type": "git",
    "url": "https://github.com/Mahi2708/codeweave-ai.git"
  },

  "bugs": {
    "url": "https://github.com/Mahi2708/codeweave-ai/issues"
  },

  "homepage": "https://github.com/Mahi2708/codeweave-ai",

  "engines": {
    "vscode": "^1.100.0"
  },

  "categories": [
    "Other",
    "Machine Learning"
  ],

  "keywords": [
    "project tree",
    "project structure",
    "project explorer",
    "project structure generator",
    "file tree",
    "folder tree",
    "directory tree",
    "workspace tree",
    "code structure",
    "project manager",
    "file manager",
    "folder manager",
    "workspace manager",
    "code generator",
    "code transformation",
    "code converter",
    "code conversion",
    "AI code",
    "AI coding",
    "AI developer",
    "developer tools",
    "refactoring"
  ],

  "activationEvents": [
    "onCommand:codeweave.generateTree",
    "onCommand:codeweave.openManager",
    "onCommand:codeweave.renamePath",
    "onCommand:codeweave.createFile",
    "onCommand:codeweave.createFolder",
    "onCommand:codeweave.aiTransform",
    "onCommand:codeweave.aiGenerateFile",
    "onCommand:codeweave.configureAi"
  ],

  "main": "./dist/extension.js",

  "icon": "images/icon.png",

  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },

  "contributes": {
    "commands": [
      {
        "command": "codeweave.generateTree",
        "title": "CodeWeave: Generate Project Tree"
      },
      {
        "command": "codeweave.openManager",
        "title": "CodeWeave: Open Project Manager"
      },
      {
        "command": "codeweave.renamePath",
        "title": "CodeWeave: Rename File or Folder"
      },
      {
        "command": "codeweave.createFile",
        "title": "CodeWeave: Create File"
      },
      {
        "command": "codeweave.createFolder",
        "title": "CodeWeave: Create Folder"
      },
      {
        "command": "codeweave.aiTransform",
        "title": "CodeWeave: AI Transform Selected File"
      },
      {
        "command": "codeweave.aiGenerateFile",
        "title": "CodeWeave: AI Generate File"
      },
      {
        "command": "codeweave.configureAi",
        "title": "CodeWeave: Configure AI Provider"
      }
    ],

    "menus": {
      "explorer/context": [
        {
          "command": "codeweave.openManager",
          "group": "codeweave@1"
        },
        {
          "command": "codeweave.renamePath",
          "group": "codeweave@2"
        },
        {
          "command": "codeweave.createFile",
          "group": "codeweave@3"
        },
        {
          "command": "codeweave.createFolder",
          "group": "codeweave@4"
        },
        {
          "command": "codeweave.aiTransform",
          "group": "codeweave@5",
          "when": "resourceExtname != ''"
        },
        {
          "command": "codeweave.aiGenerateFile",
          "group": "codeweave@6"
        }
      ],

      "editor/context": [
        {
          "command": "codeweave.aiTransform",
          "group": "codeweave@1",
          "when": "editorTextFocus"
        }
      ]
    },

    "configuration": {
      "title": "CodeWeave AI",
      "properties": {
        "codeweave.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "openrouter"
          ],
          "default": "openrouter",
          "description": "AI provider used by CodeWeave."
        },

        "codeweave.aiModel": {
          "type": "string",
          "default": "openrouter/free",
          "description": "Model identifier. For OpenRouter use a provider/model slug; for OpenAI/Gemini use a model supported by your account."
        },

        "codeweave.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Exclude paths matched by workspace .gitignore files."
        },

        "codeweave.useFrameworkIgnores": {
          "type": "boolean",
          "default": true,
          "description": "Exclude common dependency, build, cache and generated directories based on detected project technology."
        },

        "codeweave.showIgnoredInSelector": {
          "type": "boolean",
          "default": false,
          "description": "Show ignored paths in the selector as disabled items."
        },

        "codeweave.maxDepth": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum directory depth scanned by CodeWeave."
        },

        "codeweave.confirmAiFileSend": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before sending source code to an external AI provider."
        },

        "codeweave.maxAiContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum source-code characters included in an AI request."
        }
      }
    }
  },

  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ --watch",
    "test": "npm run compile && node ./test/smoke.js",
    "package": "npm run compile && vsce package"
  },

  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.7.0",
    "@vscode/vsce": "^3.6.0"
  },

  "dependencies": {
    "ignore": "^7.0.5"
  }
}